---
import type { Discussion, User } from "../../data/types";

interface Props {
  discussion: Discussion;
  users: User[];
}

const { discussion, users } = Astro.props;

// Derive a tag from the title's first word for visual variety
const tag = discussion.title.split(" ").slice(0, 2).join(" ").replace("?", "");
---

<a
  href="#"
  class="card-surface group flex flex-col gap-4 p-5 transition focus-visible:outline-2 focus-visible:outline-[color:var(--primary-strong)]"
>
  <div class="flex items-start justify-between gap-3">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-[color:var(--primary)]/25 bg-[color:var(--primary)]/10 px-2.5 py-1 text-[11px] font-medium uppercase tracking-wider text-[color:var(--primary)]">
      <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--primary)]"></span>
      Thread
    </span>
    <span class="text-xs text-[color:var(--text-muted)]">{discussion.lastActive}</span>
  </div>

  <h3 class="text-base font-semibold leading-snug text-[color:var(--text-main)] transition group-hover:text-[color:var(--primary)]">
    {discussion.title}
  </h3>

  <div class="mt-auto flex items-center justify-between gap-3">
    <div class="flex -space-x-2">
      {users.slice(0, 4).map((user) => (
        <img
          src={user.avatar}
          alt={`${user.username} avatar`}
          class="h-7 w-7 rounded-full border-2 border-[color:var(--surface-1)] object-cover"
          loading="lazy"
        />
      ))}
    </div>
    <div class="flex items-center gap-1.5 text-xs font-medium text-[color:var(--text-muted)]">
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
      </svg>
      {discussion.replies} replies
    </div>
  </div>
</a>
