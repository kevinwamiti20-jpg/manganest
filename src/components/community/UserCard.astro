---
import type { User } from "../../data/types";

interface Props {
  user: User;
}

const { user } = Astro.props;
---

<article class="card-surface p-5">
  <div class="mb-4 flex items-center gap-3">
    <img src={user.avatar} alt={`${user.username} avatar`} class="h-12 w-12 rounded-full object-cover" loading="lazy" />
    <div>
      <h3 class="text-sm font-semibold text-[color:var(--text-main)]">{user.username}</h3>
      <p class="text-xs text-[color:var(--text-muted)]">{user.followers} followers</p>
    </div>
  </div>
  <p class="mb-3 text-sm text-[color:var(--text-muted)]">{user.bio}</p>
  <p class="mb-3 text-xs text-[color:var(--text-muted)]">Reads this month: {user.readsThisMonth}</p>
  <div class="mb-4 flex flex-wrap gap-2">
    {user.favoriteGenres.slice(0, 2).map((genre) => (
      <span class="rounded-full bg-[color:var(--surface-2)] px-2.5 py-1 text-xs text-[color:var(--text-muted)]">{genre}</span>
    ))}
  </div>
  <button type="button" class="btn-ghost w-full text-sm">Follow</button>
</article>
