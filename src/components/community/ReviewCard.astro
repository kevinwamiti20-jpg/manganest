---
import type { Review, User, Manga } from "../../data/types";

interface Props {
  review: Review;
  user: User;
  manga: Manga;
}

const { review, user, manga } = Astro.props;
---

<article class="card-surface group relative flex gap-4 overflow-hidden p-5">
  <!-- Cover thumbnail -->
  <a href={`/manga/${manga.slug}`} class="relative shrink-0">
    <img
      src={manga.cover}
      alt={`${manga.title} cover`}
      class="aspect-[2/3] w-20 rounded-lg border border-white/10 object-cover transition group-hover:scale-[1.03] sm:w-24"
      loading="lazy"
    />
  </a>

  <!-- Body -->
  <div class="flex min-w-0 flex-1 flex-col">
    <!-- Header: user + rating -->
    <div class="mb-2 flex items-start justify-between gap-3">
      <div class="flex min-w-0 items-center gap-2.5">
        <img src={user.avatar} alt="" class="h-8 w-8 shrink-0 rounded-full border border-white/10 object-cover" loading="lazy" />
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold text-[color:var(--text-main)]">{user.username}</p>
          <p class="truncate text-xs text-[color:var(--text-muted)]">{review.createdAt}</p>
        </div>
      </div>
      <div class="inline-flex shrink-0 items-center gap-1 rounded-full border border-white/10 bg-white/[0.04] px-2.5 py-1 text-xs font-medium text-[color:var(--text-main)]">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-[color:var(--primary)]" fill="currentColor" aria-hidden="true">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.62L12 2 9.19 8.62 2 9.24l5.46 4.73L5.82 21z" />
        </svg>
        {review.rating.toFixed(1)}
      </div>
    </div>

    <!-- Manga title -->
    <a href={`/manga/${manga.slug}`} class="text-sm font-semibold text-[color:var(--primary)] hover:underline">
      {manga.title}
    </a>

    <!-- Review text -->
    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-[color:var(--text-muted)]">
      "{review.text}"
    </p>

    <!-- Actions -->
    <div class="mt-4 flex items-center gap-4 text-xs text-[color:var(--text-muted)]">
      <button type="button" class="inline-flex items-center gap-1.5 transition hover:text-[color:var(--primary)]">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M14 9V5a3 3 0 0 0-6 0v4H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12.28a2 2 0 0 0 2-1.7l1.38-9A2 2 0 0 0 18.66 9H14z" />
        </svg>
        {review.likes}
      </button>
      <button type="button" class="inline-flex items-center gap-1.5 transition hover:text-[color:var(--primary)]">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
        {review.comments}
      </button>
      <button type="button" class="ml-auto inline-flex items-center gap-1.5 transition hover:text-[color:var(--primary)]" aria-label="Save">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
        </svg>
      </button>
    </div>
  </div>
</article>
