---
interface Props {
  slug: string;
  title: string;
  chapter: number;
}

const { slug, title, chapter } = Astro.props;
---

<header class="sticky top-0 z-30 mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-white/10 bg-[color:var(--surface-0)]/80 p-3 backdrop-blur-xl sm:p-4">
  <a href={`/manga/${slug}`} class="btn-ghost text-sm">Back to manga</a>
  <div class="text-center">
    <p class="text-sm font-semibold text-[color:var(--text-main)]">{title}</p>
    <p class="text-xs text-[color:var(--text-muted)]">Chapter {chapter}</p>
  </div>
  <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-[color:var(--text-muted)]">Vertical mode</span>
</header>
