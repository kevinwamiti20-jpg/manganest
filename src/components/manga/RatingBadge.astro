---
interface Props {
  rating: number;
}

const { rating } = Astro.props;
---

<span class="inline-flex items-center gap-1 rounded-full bg-[color:var(--primary)]/20 px-2.5 py-1 text-xs font-semibold text-[color:var(--primary-strong)]">
  <span aria-hidden="true">★</span>
  {rating.toFixed(1)}
</span>
