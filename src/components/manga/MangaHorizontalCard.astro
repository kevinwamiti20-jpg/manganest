---
import type { Manga } from "../../data/types";
import GenreChip from "./GenreChip.astro";
import RatingBadge from "./RatingBadge.astro";

interface Props {
  item: Manga;
}

const { item } = Astro.props;
---

<article class="card-surface overflow-hidden">
  <a href={`/manga/${item.slug}`} class="grid gap-4 p-4 sm:grid-cols-[120px,1fr] sm:p-5">
    <img src={item.cover} alt={`${item.title} cover`} class="aspect-[2/3] w-full rounded-lg object-cover sm:h-44" loading="lazy" />
    <div class="space-y-3">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-lg font-semibold tracking-tight text-[color:var(--text-main)]">{item.title}</h3>
        <RatingBadge rating={item.rating} />
      </div>
      <p class="line-clamp-2 text-sm text-[color:var(--text-muted)]">{item.description}</p>
      <div class="flex flex-wrap gap-2">
        {item.genres.slice(0, 3).map((genre) => <GenreChip label={genre} />)}
      </div>
      <p class="text-xs uppercase tracking-wide text-[color:var(--text-muted)]">{item.readerCount} readers • Chapter {item.latestChapter}</p>
    </div>
  </a>
</article>
