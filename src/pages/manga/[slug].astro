---
import AppLayout from "../../layouts/AppLayout.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import GenreChip from "../../components/manga/GenreChip.astro";
import StatusPill from "../../components/manga/StatusPill.astro";
import ChapterList from "../../components/manga/ChapterList.astro";
import SimilarManga from "../../components/manga/SimilarManga.astro";
import ReviewCard from "../../components/community/ReviewCard.astro";
import { manga } from "../../data/manga";
import { comments } from "../../data/comments";
import { reviews } from "../../data/reviews";
import { userById } from "../../data/index";

export function getStaticPaths() {
  return manga.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const related = manga
  .filter((entry) => entry.slug !== item.slug && entry.genres.some((genre) => item.genres.includes(genre)))
  .slice(0, 4);
const topReview = reviews.find((review) => review.mangaSlug === item.slug) ?? reviews[0];
const threadComments = comments.filter((comment) => comment.mangaSlug === item.slug).slice(0, 3);

const ratingBreakdown = [
  { star: 5, pct: 62 },
  { star: 4, pct: 25 },
  { star: 3, pct: 9 },
  { star: 2, pct: 3 },
  { star: 1, pct: 1 }
];
---

<AppLayout
  title={`${item.title} | MangaNest`}
  description={item.description}
  fullBleed={true}
>
  <!-- Cinematic banner hero -->
  <section class="relative">
    <div class="relative h-[420px] w-full overflow-hidden sm:h-[480px] lg:h-[560px]">
      <img
        src={item.banner}
        alt={`${item.title} banner`}
        class="absolute inset-0 h-full w-full scale-105 object-cover blur-[2px]"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[color:var(--surface-0)] via-[color:var(--surface-0)]/80 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[color:var(--surface-0)] via-[color:var(--surface-0)]/40 to-transparent"></div>
    </div>

    <div class="relative -mt-72 px-4 pb-10 sm:px-6 lg:-mt-80 lg:px-10">
      <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[260px,1fr] lg:gap-10">
        <!-- Cover -->
        <div class="relative">
          <img
            src={item.cover}
            alt={`${item.title} cover`}
            class="aspect-[2/3] w-full max-w-[260px] rounded-2xl border border-white/10 object-cover shadow-2xl shadow-black/60"
          />
        </div>

        <!-- Meta -->
        <div class="flex flex-col justify-end">
          <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
            <StatusPill status={item.status} />
            <span class="rounded-full border border-white/15 bg-black/30 px-2.5 py-1 text-[color:var(--text-muted)] backdrop-blur">
              {item.year}
            </span>
            <span class="inline-flex items-center gap-1 rounded-full border border-white/15 bg-black/30 px-2.5 py-1 text-[color:var(--text-main)] backdrop-blur">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 text-[color:var(--primary)]" fill="currentColor" aria-hidden="true">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.62L12 2 9.19 8.62 2 9.24l5.46 4.73L5.82 21z" />
              </svg>
              {item.rating.toFixed(1)}
            </span>
            <span class="rounded-full border border-white/15 bg-black/30 px-2.5 py-1 text-[color:var(--text-muted)] backdrop-blur">
              {item.readerCount} readers
            </span>
          </div>

          <h1 class="text-4xl font-extrabold tracking-tight text-white drop-shadow-lg sm:text-5xl lg:text-6xl">
            {item.title}
          </h1>
          {item.altTitle && (
            <p class="mt-2 text-base text-[color:var(--text-muted)]">{item.altTitle}</p>
          )}

          <div class="mt-4 flex flex-wrap gap-1.5">
            {item.genres.map((genre) => <GenreChip label={genre} />)}
          </div>

          <p class="mt-5 max-w-3xl text-sm leading-relaxed text-[color:var(--text-muted)] sm:text-base">
            {item.description}
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a href={`/read/${item.slug}/1`} class="btn-primary">
              <svg viewBox="0 0 24 24" class="mr-2 h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
              Start Reading
            </a>
            <a href={`/read/${item.slug}/${item.latestChapter}`} class="btn-ghost">
              Latest: Ch. {item.latestChapter}
            </a>
            <button type="button" class="btn-ghost" aria-label="Add to library">
              <svg viewBox="0 0 24 24" class="mr-2 h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
              </svg>
              Add to List
            </button>
            <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-[color:var(--text-muted)] transition hover:border-[color:var(--primary)]/40 hover:text-[color:var(--primary)]" aria-label="Share">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="18" cy="5" r="3" />
                <circle cx="6" cy="12" r="3" />
                <circle cx="18" cy="19" r="3" />
                <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Body -->
  <div class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[1fr,320px]">
      <!-- Main column -->
      <div class="space-y-10">
        <!-- Synopsis -->
        <section>
          <h2 class="mb-4 text-xl font-bold tracking-tight">Synopsis</h2>
          <p class="text-base leading-relaxed text-[color:var(--text-muted)]">
            {item.description} The world expands through escalating conspiracies, emotional character beats,
            and visual set pieces designed for long-form binge reading.
          </p>
        </section>

        <!-- Chapters -->
        <section>
          <div class="mb-4 flex items-end justify-between gap-3">
            <div>
              <h2 class="text-xl font-bold tracking-tight">Chapters</h2>
              <p class="mt-1 text-sm text-[color:var(--text-muted)]">{item.chapters.length} chapters · Updated {item.updatedAgo}</p>
            </div>
            <button type="button" class="btn-ghost text-sm">Newest first</button>
          </div>
          <ChapterList slug={item.slug} chapters={item.chapters} />
        </section>

        <!-- Community -->
        <section>
          <SectionHeader title="Community Snapshot" subtitle="Reader sentiment, quick reactions, and engagement." />
          <div class="grid gap-4 lg:grid-cols-[1.1fr,0.9fr]">
            <div class="space-y-4">
              <article class="card-surface p-5">
                <p class="mb-4 text-sm font-semibold">Rating breakdown</p>
                <div class="space-y-2.5">
                  {ratingBreakdown.map((row) => (
                    <div class="flex items-center gap-3 text-xs text-[color:var(--text-muted)]">
                      <span class="w-6 shrink-0 text-right font-medium text-[color:var(--text-main)]">{row.star}★</span>
                      <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-white/10">
                        <div class="h-full rounded-full bg-[color:var(--primary)]" style={`width: ${row.pct}%`}></div>
                      </div>
                      <span class="w-9 shrink-0 text-right tabular-nums">{row.pct}%</span>
                    </div>
                  ))}
                </div>
                <p class="mt-4 text-xs text-[color:var(--text-muted)]">Reader count: {item.readerCount}</p>
              </article>
              <ReviewCard review={topReview} user={userById[topReview.userId]} manga={item} />
            </div>
            <article class="card-surface p-5">
              <h3 class="mb-3 text-base font-semibold">Recent comments</h3>
              <div class="space-y-3">
                {threadComments.map((comment) => (
                  <div class="rounded-lg border border-white/10 bg-white/[0.02] p-3">
                    <p class="text-sm text-[color:var(--text-main)]">{comment.body}</p>
                    <p class="mt-1.5 text-xs text-[color:var(--text-muted)]">
                      {userById[comment.userId].username} · {comment.createdAt}
                    </p>
                  </div>
                ))}
              </div>
            </article>
          </div>
        </section>

        <!-- Similar -->
        <section>
          <SectionHeader title="More like this" subtitle="Stories that share the same atmosphere." />
          <SimilarManga items={related} />
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <article class="card-surface p-5">
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-[color:var(--text-muted)]">Details</h3>
          <dl class="space-y-3 text-sm">
            <div class="flex items-center justify-between gap-3">
              <dt class="text-[color:var(--text-muted)]">Author</dt>
              <dd class="font-medium text-[color:var(--text-main)]">{item.author}</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-[color:var(--text-muted)]">Artist</dt>
              <dd class="font-medium text-[color:var(--text-main)]">{item.artist}</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-[color:var(--text-muted)]">Released</dt>
              <dd class="font-medium text-[color:var(--text-main)]">{item.year}</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-[color:var(--text-muted)]">Status</dt>
              <dd><StatusPill status={item.status} /></dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-[color:var(--text-muted)]">Chapters</dt>
              <dd class="font-medium text-[color:var(--text-main)]">{item.chapters.length}</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-[color:var(--text-muted)]">Direction</dt>
              <dd class="font-medium text-[color:var(--text-main)]">Vertical scroll</dd>
            </div>
          </dl>
        </article>

        <article class="card-surface p-5">
          <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-[color:var(--text-muted)]">Genres</h3>
          <div class="flex flex-wrap gap-1.5">
            {item.genres.map((genre) => <GenreChip label={genre} />)}
          </div>
        </article>
      </aside>
    </div>
  </div>
</AppLayout>
