---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import GenreChip from "../../components/manga/GenreChip.astro";
import StatusPill from "../../components/manga/StatusPill.astro";
import RatingBadge from "../../components/manga/RatingBadge.astro";
import ChapterList from "../../components/manga/ChapterList.astro";
import SimilarManga from "../../components/manga/SimilarManga.astro";
import ReviewCard from "../../components/community/ReviewCard.astro";
import { manga } from "../../data/manga";
import { comments } from "../../data/comments";
import { reviews } from "../../data/reviews";
import { userById } from "../../data/index";

export function getStaticPaths() {
  return manga.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const related = manga.filter((entry) => entry.slug !== item.slug && entry.genres.some((genre) => item.genres.includes(genre))).slice(0, 4);
const topReview = reviews.find((review) => review.mangaSlug === item.slug) ?? reviews[0];
const threadComments = comments.filter((comment) => comment.mangaSlug === item.slug).slice(0, 3);
---

<BaseLayout
  title={`${item.title} | MangaNest`}
  description={item.description}
>
  <section class="relative mb-10 overflow-hidden rounded-2xl border border-white/10 bg-[color:var(--surface-1)] p-5 sm:p-8">
    <img src={item.banner} alt={`${item.title} banner`} class="absolute inset-0 h-full w-full object-cover opacity-25 blur-sm" />
    <div class="relative grid gap-6 lg:grid-cols-[220px,1fr] lg:gap-8">
      <img src={item.cover} alt={`${item.title} cover`} class="aspect-[2/3] w-full max-w-[220px] rounded-xl object-cover" />
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{item.title}</h1>
        {item.altTitle && <p class="mt-1 text-sm text-[color:var(--text-muted)]">{item.altTitle}</p>}
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <RatingBadge rating={item.rating} />
          <StatusPill status={item.status} />
          {item.genres.map((genre) => <GenreChip label={genre} />)}
        </div>
        <p class="mt-5 max-w-3xl text-sm leading-relaxed text-[color:var(--text-muted)] sm:text-base">{item.description}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={`/read/${item.slug}/1`} class="btn-primary">Start Reading</a>
          <button type="button" class="btn-ghost">Add to List</button>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <article class="card-surface p-4"><p class="text-xs text-[color:var(--text-muted)]">Author</p><p class="mt-1 text-sm font-semibold">{item.author}</p></article>
    <article class="card-surface p-4"><p class="text-xs text-[color:var(--text-muted)]">Artist</p><p class="mt-1 text-sm font-semibold">{item.artist}</p></article>
    <article class="card-surface p-4"><p class="text-xs text-[color:var(--text-muted)]">Release year</p><p class="mt-1 text-sm font-semibold">{item.year}</p></article>
    <article class="card-surface p-4"><p class="text-xs text-[color:var(--text-muted)]">Status</p><p class="mt-1 text-sm font-semibold">{item.status}</p></article>
    <article class="card-surface p-4"><p class="text-xs text-[color:var(--text-muted)]">Chapters</p><p class="mt-1 text-sm font-semibold">{item.chapters.length}</p></article>
    <article class="card-surface p-4"><p class="text-xs text-[color:var(--text-muted)]">Reading direction</p><p class="mt-1 text-sm font-semibold">Vertical scroll</p></article>
  </section>

  <section class="mb-10">
    <SectionHeader title="Synopsis" />
    <article class="card-surface max-w-4xl p-5">
      <p class="text-sm leading-relaxed text-[color:var(--text-muted)]">{item.description} The world expands through escalating conspiracies, emotional character beats, and visual set pieces designed for long-form binge reading.</p>
    </article>
  </section>

  <section class="mb-10">
    <SectionHeader title="Chapter List" />
    <ChapterList slug={item.slug} chapters={item.chapters} />
  </section>

  <section class="mb-10">
    <SectionHeader title="Community Snapshot" subtitle="Reader sentiment, quick reactions, and engagement." />
    <div class="grid gap-4 lg:grid-cols-[1.1fr,0.9fr]">
      <div class="space-y-4">
        <article class="card-surface p-5">
          <p class="mb-3 text-sm font-medium">Rating breakdown</p>
          <div class="space-y-2 text-sm text-[color:var(--text-muted)]">
            <p>5★ 62%</p>
            <p>4★ 25%</p>
            <p>3★ 9%</p>
            <p>2★ 3%</p>
            <p>1★ 1%</p>
          </div>
          <p class="mt-3 text-xs text-[color:var(--text-muted)]">Reader count: {item.readerCount}</p>
        </article>
        <ReviewCard review={topReview} user={userById[topReview.userId]} manga={item} />
      </div>
      <article class="card-surface p-5">
        <h3 class="mb-3 text-base font-semibold">Recent comments</h3>
        <div class="space-y-3">
          {threadComments.map((comment) => (
            <div class="rounded-lg border border-white/10 bg-white/[0.02] p-3">
              <p class="text-sm text-[color:var(--text-main)]">{comment.body}</p>
              <p class="mt-1 text-xs text-[color:var(--text-muted)]">{userById[comment.userId].username} • {comment.createdAt}</p>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <section>
    <SectionHeader title="Similar Manga" />
    <SimilarManga items={related} />
  </section>
</BaseLayout>
