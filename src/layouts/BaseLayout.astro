---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title: string;
  description: string;
  readerMode?: boolean;
}

const { title, description, readerMode = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class:list={["min-h-screen text-[color:var(--text-main)]", readerMode ? "reader-bg" : "app-bg"]}>
    {!readerMode && <Header />}
    <main class:list={["mx-auto w-full max-w-screen-2xl px-4 sm:px-6 lg:px-10", readerMode ? "py-4" : "py-8 sm:py-10"]}>
      <slot />
    </main>
    {!readerMode && <Footer />}
  </body>
</html>
