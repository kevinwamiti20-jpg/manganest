---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  /** Pathname used to determine which nav item is active. Defaults to Astro.url.pathname. */
  currentPath?: string;
  /** Disable the centered max-w-7xl content wrapper if you need full-bleed children. */
  fullBleed?: boolean;
}

const { title, description, currentPath, fullBleed = false } = Astro.props;
const pathname = (currentPath ?? Astro.url.pathname).replace(/\/+$/, "") || "/";

const primaryNav = [
  { href: "/", label: "Home", match: (p: string) => p === "/" },
  { href: "/explore", label: "Explore", match: (p: string) => p.startsWith("/explore") || p.startsWith("/manga") || p.startsWith("/read") },
  { href: "/community", label: "Community", match: (p: string) => p.startsWith("/community") },
  { href: "/collections", label: "Collections", match: (p: string) => p.startsWith("/collections") }
];

const utilityLinks = [
  { label: "Library", icon: "M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 1 6.5 2H20v15H6.5A2.5 2.5 0 0 0 4 19.5v-15z", active: true },
  { label: "History", icon: "M3 12a9 9 0 1 0 3-6.7M3 4v5h5M12 7v5l3 2" },
  { label: "Downloads", icon: "M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" },
  { label: "Settings", icon: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm7.4-3a7.4 7.4 0 0 0-.1-1.3l2.1-1.6-2-3.5-2.5 1a7.4 7.4 0 0 0-2.2-1.3L14.3 2h-4.6l-.4 2.7a7.4 7.4 0 0 0-2.2 1.3l-2.5-1-2 3.5 2.1 1.6c-.1.4-.1.9-.1 1.3s0 .9.1 1.3L2.6 14l2 3.5 2.5-1c.7.5 1.4 1 2.2 1.3l.4 2.7h4.6l.4-2.7c.8-.3 1.5-.7 2.2-1.3l2.5 1 2-3.5-2.1-1.6c.1-.4.1-.9.1-1.3z" },
  { label: "Help", icon: "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01" }
];

const proCardImage =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuBVqZXDO13jzY2Bp5BnEIImvmq0X9ZcUuZqSYK3MxGdx5V5_nfdDkv5Zdf87sUQ-T9Hvxx9z_BimgeeGP3VOvOBKZpWfSET4noEFjNA9fVOaHyW7e9Dcypce4wjMM1doBoXTm2j74QxOtOaAVCxq8Xdk4K5B-wKQLDQl5ksm_3anRLmQ3C2UXtaI_mEFW1eTjegUkj7R26u67g42cjJXp4f1A_bLxuMQ7_mMqs3LckndopIhThvpq_Gfee91Z1W8xIIUsWPxcCjSog9";
const navAvatarImage =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuAbbq5OUhp1fPkIbTPU85c8Mc50s8Eb9PcAfk-8dDpL_Kqhvgd4lxe332QODVr31lITCoELdTkhbEIMKZ1k3GljUCyE7f7Gm1po0_zL3DVyB4uNciGsI25EkMtVXxUxamMp583rhtV2drWwkCu7jIxmTC9MiFgjBk5E9BrZ-YGfjnvaFYZwp_2Mambw5f7X5ET9pxgGXsWNP1Z5m0vAUbaG_7h9m0lfW5NpdnaiJEfkUwqItVQEZgEFvDVvxiMjB9r5o_k_78au80xC";
---

<BaseLayout title={title} description={description} hideSiteChrome={true}>
  <!-- Fixed top navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 flex h-16 items-center justify-between gap-3 border-b border-white/5 bg-[color:var(--surface-0)]/70 px-4 backdrop-blur-xl sm:px-6 lg:px-8">
    <div class="flex items-center gap-3 md:gap-8">
      <!-- Mobile menu button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-[color:var(--text-muted)] transition hover:bg-white/5 hover:text-[color:var(--text-main)] md:hidden"
        aria-label="Open menu"
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <a href="/" class="text-lg font-bold tracking-tight text-[color:var(--text-main)]">MangaNest</a>
      <nav class="hidden items-center gap-6 text-sm md:flex" aria-label="Primary">
        {primaryNav.map((link) => {
          const isActive = link.match(pathname);
          return (
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "app-nav-link font-medium",
                isActive
                  ? "font-semibold"
                  : "text-[color:var(--text-muted)] hover:text-[color:var(--text-main)]"
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="flex items-center gap-1 sm:gap-2 md:gap-3">
      <div class="hidden items-center gap-2 rounded-full border border-white/10 bg-[color:var(--surface-1)]/80 px-4 py-2 md:flex">
        <svg viewBox="0 0 24 24" class="h-4 w-4 text-[color:var(--text-muted)]" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          placeholder="Search titles, authors, genres..."
          class="w-48 border-none bg-transparent p-0 text-sm text-[color:var(--text-main)] placeholder:text-[color:var(--text-muted)] focus:outline-none lg:w-64"
        />
      </div>

      <!-- Mobile search icon -->
      <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-full text-[color:var(--text-muted)] transition hover:bg-white/5 hover:text-[color:var(--primary)] md:hidden" aria-label="Search">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <button type="button" class="hidden h-9 w-9 items-center justify-center rounded-full text-[color:var(--text-muted)] transition hover:bg-white/5 hover:text-[color:var(--primary)] sm:inline-flex" aria-label="Notifications">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
      </button>
      <button type="button" class="hidden h-9 w-9 items-center justify-center rounded-full text-[color:var(--text-muted)] transition hover:bg-white/5 hover:text-[color:var(--primary)] sm:inline-flex" aria-label="Bookmarks">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
      </button>
      <img src={navAvatarImage} alt="User avatar" class="h-9 w-9 rounded-full border border-[color:var(--primary)]/30 object-cover" loading="lazy" />
    </div>
  </nav>

  <!-- Mobile drawer (slides from left, hidden on lg+) -->
  <div
    id="mobile-drawer-backdrop"
    class="fixed inset-0 z-40 hidden bg-black/60 backdrop-blur-sm lg:!hidden"
    aria-hidden="true"
  ></div>
  <aside
    id="mobile-drawer"
    class="fixed bottom-0 left-0 top-0 z-50 flex w-72 max-w-[85%] -translate-x-full flex-col border-r border-white/10 bg-[color:var(--surface-0)] p-5 transition-transform duration-300 ease-out lg:hidden"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    <div class="mb-6 flex items-center justify-between">
      <a href="/" class="text-lg font-bold tracking-tight text-[color:var(--text-main)]">MangaNest</a>
      <button
        type="button"
        id="mobile-menu-close"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-[color:var(--text-muted)] transition hover:bg-white/5 hover:text-[color:var(--text-main)]"
        aria-label="Close menu"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Mobile search -->
    <div class="mb-6 flex items-center gap-2 rounded-full border border-white/10 bg-[color:var(--surface-1)]/80 px-4 py-2">
      <svg viewBox="0 0 24 24" class="h-4 w-4 text-[color:var(--text-muted)]" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        placeholder="Search..."
        class="w-full border-none bg-transparent p-0 text-sm text-[color:var(--text-main)] placeholder:text-[color:var(--text-muted)] focus:outline-none"
      />
    </div>

    <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-[color:var(--text-muted)]">Browse</p>
    <nav class="mb-6 space-y-1" aria-label="Mobile primary">
      {primaryNav.map((link) => {
        const isActive = link.match(pathname);
        return (
          <a
            href={link.href}
            aria-current={isActive ? "page" : undefined}
            class:list={[
              "nav-row-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm",
              isActive
                ? "bg-[color:var(--primary)]/15 font-semibold text-[color:var(--primary)]"
                : "text-[color:var(--text-muted)] hover:bg-white/5 hover:text-[color:var(--text-main)]"
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-[color:var(--text-muted)]">Library</p>
    <nav class="space-y-1" aria-label="Mobile utility">
      {utilityLinks.map((link) => (
        <a
          href="#"
          class:list={[
            "nav-row-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm",
            link.active
              ? "bg-[color:var(--primary)]/15 text-[color:var(--primary)]"
              : "text-[color:var(--text-muted)] hover:bg-white/5 hover:text-[color:var(--text-main)]"
          ]}
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={link.icon}></path>
          </svg>
          <span>{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="mt-auto rounded-2xl border border-white/10 bg-[color:var(--surface-2)]/70 p-4">
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[color:var(--primary)]">Pro Plan</p>
      <p class="mt-2 text-sm font-medium text-[color:var(--text-main)]">Access exclusive high-fidelity scans.</p>
      <button type="button" class="btn-primary mt-3 w-full text-sm">Upgrade to Pro</button>
    </div>
  </aside>

  <!-- Fixed desktop sidebar -->
  <aside class="fixed bottom-0 left-0 top-16 z-40 hidden w-64 flex-col border-r border-white/5 bg-[color:var(--surface-1)]/60 p-4 backdrop-blur-xl lg:flex">
    <nav class="space-y-1" aria-label="Sidebar">
      {utilityLinks.map((link) => (
        <a
          href="#"
          class:list={[
            "nav-row-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm",
            link.active
              ? "bg-[color:var(--primary)]/15 text-[color:var(--primary)]"
              : "text-[color:var(--text-muted)] hover:bg-white/5 hover:text-[color:var(--text-main)]"
          ]}
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={link.icon}></path>
          </svg>
          <span>{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="mt-auto rounded-2xl border border-white/10 bg-[color:var(--surface-2)]/70 p-4">
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[color:var(--primary)]">Pro Plan</p>
      <p class="mt-2 text-sm font-medium text-[color:var(--text-main)]">Access exclusive high-fidelity scans.</p>
      <img src={proCardImage} alt="MangaNest pro preview" class="mt-3 h-24 w-full rounded-lg object-cover" loading="lazy" />
      <button type="button" class="btn-primary mt-3 w-full text-sm">Upgrade to Pro</button>
    </div>
  </aside>

  <!-- Main content offset by sidebar + nav -->
  <main class="pt-20 lg:ml-64">
    {fullBleed ? (
      <slot />
    ) : (
      <div class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-10">
        <slot />
      </div>
    )}
  </main>
</BaseLayout>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const closeBtn = document.getElementById("mobile-menu-close");
  const drawer = document.getElementById("mobile-drawer");
  const backdrop = document.getElementById("mobile-drawer-backdrop");

  const open = () => {
    if (!drawer || !backdrop || !toggle) return;
    drawer.classList.remove("-translate-x-full");
    drawer.setAttribute("aria-hidden", "false");
    backdrop.classList.remove("hidden");
    toggle.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };

  const close = () => {
    if (!drawer || !backdrop || !toggle) return;
    drawer.classList.add("-translate-x-full");
    drawer.setAttribute("aria-hidden", "true");
    backdrop.classList.add("hidden");
    toggle.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", open);
  closeBtn?.addEventListener("click", close);
  backdrop?.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>
